{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "aquariums": {
      "$aquarium_id": {
        ".read": "auth != null",
        ".write": "auth != null && newData.child('users').child(auth.uid).val() === 'o'"
      }
    }
  }
}