{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "instant": {
      "type": "object",
      "required": ["timestamp", "value"],
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "number"
        }
      }
    },
    "period": {
      "type": "object",
      "required": ["index", "timestamp", "values"],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^([0-9]|[1-9][0-9])$": {
              "type": "number"
            }
          }
        }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_instant": { "$ref": "#/$defs/instant" },
        "last_hour": { "$ref": "#/$defs/period" },
        "last_day": { "$ref": "#/$defs/period" },
        "last_week": { "$ref": "#/$defs/period" },
        "last_month": { "$ref": "#/$defs/period" },
        "last_year": { "$ref": "#/$defs/period" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[A-Za-z0-9_-]{28}$": {
      "type": "object",
      "required": ["email"],
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "aquariums": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9_-]{20}$": {
              "type": "string"
            }
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9_-]{20}$": {
              "type": "object",
              "required": ["temperature", "water_level", "dissolved_solids", "ph_level"],
              "additionalProperties": false,
              "properties": {
                "temperature": { "$ref": "#/$defs/sensor" },
                "water_level": { "$ref": "#/$defs/sensor" },
                "dissolved_solids": { "$ref": "#/$defs/sensor" },
                "ph_level": { "$ref": "#/$defs/sensor" }
              }
            }
          }
        }
      }
    }
  }
}
