{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "instant": {
      "type": "object",
      "required": ["timestamp", "value"],
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 1777608000,
          "maximum": 1788235200
        },
        "value": {
          "type": "number"
        }
      }
    },
    "period": {
      "type": "object",
      "required": ["index", "timestamp", "values"],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "timestamp": {
          "type": "integer",
          "minimum": 1777608000,
          "maximum": 1788235200
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^B([0-9]|[1-9][0-9])$": {
              "type": "number"
            }
          }
        }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_instant": { "$ref": "#/$defs/instant" },
        "last_1h": { "$ref": "#/$defs/period" },
        "last_1d": { "$ref": "#/$defs/period" },
        "last_1w": { "$ref": "#/$defs/period" },
        "last_1m": { "$ref": "#/$defs/period" },
        "last_6m": { "$ref": "#/$defs/period" },
        "last_1y": { "$ref": "#/$defs/period" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[A-Za-z0-9_-]{28}$": {
      "type": "object",
      "required": ["account"],
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "object",
          "required": ["name", "email"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            }
          }
        },
        "aquariums": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9_-]{28}$": {
              "type": "string"
            }
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9_-]{28}$": {
              "type": "object",
              "required": ["temperature", "water_level", "dissolved_solids", "ph_level"],
              "additionalProperties": false,
              "properties": {
                "temperature": { "$ref": "#/$defs/sensor" },
                "water_level": { "$ref": "#/$defs/sensor" },
                "dissolved_solids": { "$ref": "#/$defs/sensor" },
                "ph_level": { "$ref": "#/$defs/sensor" }
              }
            }
          }
        }
      }
    }
  }
}
