{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "type": "object",
  "required": [],
  "additionalProperties": false,
  "properties": {
    "users": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9_-]{28}$": {
          "type": "object",
          "required": ["email"],
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string",
              "format": "email"
            },
            "aquariums": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "sends": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^[A-Za-z0-9_-]{20}$": {
                  "type": "object",
                  "required": ["destination", "aquarium", "permission", "accepted"],
                  "additionalProperties": false,
                  "properties": {
                    "destination": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{28}$"
                    },
                    "aquarium": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "permission": {
                      "type": "string",
                      "enum": ["w", "r"]
                    },
                    "accepted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "receives": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^[A-Za-z0-9_-]{20}$": {
                  "type": "object",
                  "required": ["source", "aquarium", "permission", "accepted"],
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{28}$"
                    },
                    "aquarium": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "permission": {
                      "type": "string",
                      "enum": ["w", "r"]
                    },
                    "accepted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "aquariums": {
      "type": "object",
      "propertyNames": {
        "format": "uuid"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "users"],
        "properties": {
          "name": {
            "type": "string"
          },
          "users": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": {
              "^[A-Za-z0-9_-]{28}$": {
                "type": "string",
                "enum": ["o", "w", "r"]
              }
            }
          },
          "telemetry": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^[0-9]{4}$": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^(0[1-9]|1[0-2])$": {
                    "type": "object",
                    "additionalProperties": false,
                    "patternProperties": {
                      "^(0[1-9]|[12][0-9]|3[01])$": {
                        "type": "object",
                        "additionalProperties": false,
                        "patternProperties": {
                          "^([01][0-9]|2[0-3])$": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": ["timestamp", "temperature", "ph_level", "dissolved_solids", "water_level"],
                              "additionalProperties": false,
                              "properties": {
                                "timestamp": {
                                  "type": "integer"
                                },
                                "temperature": {
                                  "type": "number"
                                },
                                "ph_level": {
                                  "type": "number"
                                },
                                "dissolved_solids": {
                                  "type": "number"
                                },
                                "water_level": {
                                  "type": "number"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}