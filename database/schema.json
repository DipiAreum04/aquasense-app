{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "thresholds": {
      "type": "object",
      "required": ["warn_low", "safe_low", "safe_high", "warn_high"],
      "additionalProperties": false,
      "properties": {
        "warn_low": {
          "type": "number"
        },
        "safe_low": {
          "type": "number"
        },
        "safe_high": {
          "type": "number"
        },
        "warn_high": {
          "type": "number"
        }
      }
    },
    "aquarium": {
      "type": "object",
      "required": ["name", "water_type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "water_type": {
          "type": "string",
          "enum": ["freshwater", "saltwater"]
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": { "$ref": "#/$defs/thresholds" },
            "dissolved_solids": { "$ref": "#/$defs/thresholds" },
            "ph_level": { "$ref": "#/$defs/thresholds" }
          }
        },
        "spike_deltas": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dissolved_solids": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ph_level": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "instant": {
      "type": "object",
      "required": ["timestamp", "value"],
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "type": "integer",
          "minimum": 1777608000,
          "maximum": 1788235200
        },
        "value": {
          "type": "number"
        }
      }
    },
    "period": {
      "type": "object",
      "required": ["index", "buckets"],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "buckets": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^B([0-9][0-9])$": {
              "type": "object",
              "required": ["timestamp", "value"],
              "additionalProperties": false,
              "properties": {
                "timestamp": {
                  "type": "integer",
                  "minimum": 1777608000,
                  "maximum": 1788235200
                },
                "value": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_instant": { "$ref": "#/$defs/instant" },
        "last_1h": { "$ref": "#/$defs/period" },
        "last_1d": { "$ref": "#/$defs/period" },
        "last_1w": { "$ref": "#/$defs/period" },
        "last_1m": { "$ref": "#/$defs/period" },
        "last_6m": { "$ref": "#/$defs/period" },
        "last_1y": { "$ref": "#/$defs/period" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[A-Za-z0-9_-]{28}$": {
      "type": "object",
      "required": ["account"],
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "object",
          "required": ["name", "email"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            }
          }
        },
        "aquariums": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9_-]{28}$": { "$ref": "#/$defs/aquarium" }
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9_-]{28}$": {
              "type": "object",
              "required": ["temperature", "water_level", "dissolved_solids", "ph_level"],
              "additionalProperties": false,
              "properties": {
                "temperature": { "$ref": "#/$defs/sensor" },
                "water_level": { "$ref": "#/$defs/sensor" },
                "dissolved_solids": { "$ref": "#/$defs/sensor" },
                "ph_level": { "$ref": "#/$defs/sensor" }
              }
            }
          }
        }
      }
    }
  }
}
