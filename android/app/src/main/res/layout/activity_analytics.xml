<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_analytics"
        style="@style/Widget.AquaSense.Toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/analyticsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/analyticsAquariumSelector"
                style="@style/Widget.AquaSense.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/rounded_ripple_10dp_radius"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/analyticsAquariumIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_template_icon"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="5dp"
                    tools:src="@drawable/aquarium_freshwater" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/analytics_active_aquarium"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/analyticsAquariumName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Living Room Reef" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/analyticsAquariumChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/analytics_aquarium_selector_description"
                    android:rotation="90"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_secondary" />

            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/analyticsSensorTabs"
                style="@style/Widget.AquaSense.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_settings_card"
                android:clipToOutline="true"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/accent"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="3dp"
                app:tabMode="fixed"
                app:tabPaddingEnd="6dp"
                app:tabPaddingStart="6dp" />

            <LinearLayout
                android:id="@+id/analyticsPeriodButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_analytics_period_track"
                android:orientation="horizontal"
                android:padding="4dp" />

            <LinearLayout
                style="@style/Widget.AquaSense.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="@string/analytics_system_health"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/analyticsHealthInfoButton"
                                style="@style/Widget.AquaSense.AnalyticsInfoButton"
                                android:contentDescription="@string/analytics_info_open" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/analyticsStatusLed"
                                android:layout_width="@dimen/analytics_status_led_size"
                                android:layout_height="@dimen/analytics_status_led_size"
                                android:contentDescription="@null"
                                tools:src="@drawable/blue_circle_24" />

                            <TextView
                                android:id="@+id/analyticsStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Normal" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/analyticsLastSeen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="Last seen just now" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/analytics_uptime"
                            android:textAllCaps="true"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/analyticsUptimeRing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:indeterminate="false"
                                android:max="100"
                                app:indicatorColor="@color/accent"
                                app:indicatorSize="@dimen/analytics_uptime_ring_size"
                                app:trackColor="@color/divider"
                                app:trackCornerRadius="@dimen/analytics_uptime_ring_corner"
                                app:trackThickness="@dimen/analytics_uptime_ring_thickness"
                                tools:progress="99" />

                            <TextView
                                android:id="@+id/analyticsUptimeValue"
                                android:layout_width="@dimen/analytics_uptime_ring_size"
                                android:layout_height="@dimen/analytics_uptime_ring_size"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="99%" />

                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/analyticsStatMinLabel"
                            style="@style/Widget.AquaSense.AnalyticsStatLabel"
                            android:text="@string/analytics_stat_min" />

                        <LinearLayout
                            style="@style/Widget.AquaSense.AnalyticsStatValueRow">

                            <TextView
                                android:id="@+id/analyticsStatMinValue"
                                style="@style/Widget.AquaSense.AnalyticsStatValue"
                                tools:text="24.5" />

                            <TextView
                                android:id="@+id/analyticsStatMinUnit"
                                style="@style/Widget.AquaSense.AnalyticsStatUnit"
                                tools:text="°C" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/analyticsStatAvgLabel"
                            style="@style/Widget.AquaSense.AnalyticsStatLabel"
                            android:text="@string/analytics_stat_avg" />

                        <LinearLayout
                            style="@style/Widget.AquaSense.AnalyticsStatValueRow">

                            <TextView
                                android:id="@+id/analyticsStatAvgValue"
                                style="@style/Widget.AquaSense.AnalyticsStatValue"
                                android:textColor="@color/accent"
                                tools:text="25.1" />

                            <TextView
                                android:id="@+id/analyticsStatAvgUnit"
                                style="@style/Widget.AquaSense.AnalyticsStatUnit"
                                tools:text="°C" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/analyticsStatMaxLabel"
                            style="@style/Widget.AquaSense.AnalyticsStatLabel"
                            android:text="@string/analytics_stat_max" />

                        <LinearLayout
                            style="@style/Widget.AquaSense.AnalyticsStatValueRow">

                            <TextView
                                android:id="@+id/analyticsStatMaxValue"
                                style="@style/Widget.AquaSense.AnalyticsStatValue"
                                tools:text="26.3" />

                            <TextView
                                android:id="@+id/analyticsStatMaxUnit"
                                style="@style/Widget.AquaSense.AnalyticsStatUnit"
                                tools:text="°C" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/analyticsChartCard"
                style="@style/Widget.AquaSense.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/analytics_axis_label_thickness"
                            android:layout_height="@dimen/analytics_chart_height">

                            <TextView
                                android:id="@+id/analyticsYAxisLabel"
                                android:layout_width="@dimen/analytics_chart_height"
                                android:layout_height="@dimen/analytics_axis_label_thickness"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:rotation="270"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                tools:text="°C" />

                        </FrameLayout>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/analyticsChart"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/analytics_chart_height"
                            android:layout_weight="1" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="@dimen/analytics_action_bar_inset"
                        android:layout_marginEnd="@dimen/analytics_action_bar_inset"
                        android:background="@drawable/bg_analytics_action_bar"
                        android:orientation="horizontal"
                        android:padding="@dimen/analytics_action_bar_padding">

                        <ImageButton
                            android:id="@+id/analyticsDownloadButton"
                            style="@style/Widget.AquaSense.AnalyticsChartAction"
                            android:contentDescription="@string/analytics_download_description"
                            android:src="@drawable/file_save_24px" />

                        <ImageButton
                            android:id="@+id/analyticsClearButton"
                            style="@style/Widget.AquaSense.AnalyticsChartAction"
                            android:contentDescription="@string/analytics_clear_description"
                            android:src="@drawable/delete_forever_24px"
                            app:tint="@color/status_red" />

                    </LinearLayout>

                </FrameLayout>

                <TextView
                    android:id="@+id/analyticsXAxisLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="Minutes ago" />

            </LinearLayout>

            <LinearLayout
                style="@style/Widget.AquaSense.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/analytics_distribution_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/analyticsDistributionInfoButton"
                        style="@style/Widget.AquaSense.AnalyticsInfoButton"
                        android:contentDescription="@string/analytics_info_open" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/analytics_distribution_bar_height"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_analytics_distribution_track"
                    android:clipToOutline="true"
                    android:orientation="horizontal"
                    android:weightSum="100">

                    <View
                        android:id="@+id/analyticsDistributionNormalBand"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/status_blue"
                        tools:layout_weight="85" />

                    <View
                        android:id="@+id/analyticsDistributionWarningBand"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/status_orange"
                        tools:layout_weight="12" />

                    <View
                        android:id="@+id/analyticsDistributionCriticalBand"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/status_red"
                        tools:layout_weight="3" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/Widget.AquaSense.AnalyticsLegendKey">

                            <ImageView
                                style="@style/Widget.AquaSense.AnalyticsLegendDot"
                                android:src="@drawable/blue_circle_24" />

                            <TextView
                                style="@style/Widget.AquaSense.AnalyticsLegendLabel"
                                android:text="@string/normal" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/analyticsDistributionNormalValue"
                            style="@style/Widget.AquaSense.AnalyticsLegendValue"
                            tools:text="85%" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/Widget.AquaSense.AnalyticsLegendKey">

                            <ImageView
                                style="@style/Widget.AquaSense.AnalyticsLegendDot"
                                android:src="@drawable/orange_circle_24" />

                            <TextView
                                style="@style/Widget.AquaSense.AnalyticsLegendLabel"
                                android:text="@string/warning" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/analyticsDistributionWarningValue"
                            style="@style/Widget.AquaSense.AnalyticsLegendValue"
                            tools:text="12%" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/Widget.AquaSense.AnalyticsLegendKey">

                            <ImageView
                                style="@style/Widget.AquaSense.AnalyticsLegendDot"
                                android:src="@drawable/red_circle_24" />

                            <TextView
                                style="@style/Widget.AquaSense.AnalyticsLegendLabel"
                                android:text="@string/critical" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/analyticsDistributionCriticalValue"
                            style="@style/Widget.AquaSense.AnalyticsLegendValue"
                            tools:text="3%" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
