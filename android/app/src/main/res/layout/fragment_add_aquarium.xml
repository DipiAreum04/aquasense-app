<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:clickable="true"
    android:focusable="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_add_aquarium"
        style="@style/Widget.AquaSense.Toolbar"
        android:paddingEnd="20dp" 
        android:layout_alignParentTop="true" />

    <!-- Shown by WizardProgress only on a first installation, where this screen is step 1 of 2. -->
    <include
        android:id="@+id/wizardProgress"
        layout="@layout/view_wizard_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar_add_aquarium" />

    <ScrollView
        android:id="@+id/addAquariumScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/wizardProgress">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/step_number_1"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.06"
                    android:text="@string/label_aquarium_name"
                    android:textColor="@color/gray_500"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etAquariumName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_card"
                android:hint="@string/hint_aquarium_name"
                android:imeOptions="actionDone"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="@color/gray_900"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAquariumNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Name can only contain letters, numbers, spaces, hyphens, or apostrophes."
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/stepTemplateHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/step_number_2"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.06"
                    android:text="@string/label_choose_template"
                    android:textColor="@color/gray_500"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- One row per built-in template, inflated by AddAquariumFragment from
                 BuiltInTemplates so this list cannot drift from the templates the
                 dashboard actually enforces. -->
            <LinearLayout
                android:id="@+id/templateChoiceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!--
              Step 3. The thresholds the template above implies, opened up for editing.

              Optional, and collapsed: the values inside are written whether or not it is ever
              opened, so opening it and changing nothing creates exactly the aquarium that leaving
              it shut creates. That is what makes it safe to hide.

              There is no separate "custom" template. Every water type is reachable through a named
              template, so a row offering to define thresholds from scratch would only be a worse
              route to this panel - one that starts on numbers it cannot explain.
            -->
            <LinearLayout
                android:id="@+id/stepAdvancedHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/step_number_3"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.06"
                    android:text="@string/label_advanced_thresholds"
                    android:textColor="@color/gray_500"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_optional_badge"
                    android:letterSpacing="0.03"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:text="@string/advanced_optional_badge"
                    android:textColor="@color/optional_badge_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/advancedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- The whole header is the toggle; the chevron is turned a quarter over while
                     the panel is open. -->
                <LinearLayout
                    android:id="@+id/advancedToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/action_expand_advanced_settings"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_advanced_settings"
                        android:textColor="@color/gray_900"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/advancedChevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Names the template the fields below were filled in from, so a number that
                     looks arbitrary can be traced to the choice that produced it. -->
                <TextView
                    android:id="@+id/tvAdvancedHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/advanced_pick_template_first"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <include
                    android:id="@+id/advancedEditor"
                    layout="@layout/view_threshold_editor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Button -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateAquarium"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_auth_primary_button"
            android:letterSpacing="0"
            android:text="@string/action_create_aquarium"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- Only first-installation will show the Skip pairing button -->
        <TextView
            android:id="@+id/btnSkipPairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/add_aquarium_first_run_skip"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

</RelativeLayout>
