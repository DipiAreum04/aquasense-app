<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_add_aquarium"
        style="@style/Widget.AquaSense.Toolbar"
        android:paddingEnd="20dp" 
        android:layout_alignParentTop="true" />

    <ScrollView
        android:id="@+id/addAquariumScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/toolbar_add_aquarium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/step_number_1"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.06"
                    android:text="@string/label_aquarium_name"
                    android:textColor="@color/gray_500"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etAquariumName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_card"
                android:hint="@string/hint_aquarium_name"
                android:imeOptions="actionDone"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="@color/gray_900"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAquariumNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Name can only contain letters, numbers, spaces, hyphens, or apostrophes."
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/stepTemplateHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/step_number_2"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.06"
                    android:text="@string/label_choose_template"
                    android:textColor="@color/gray_500"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- One row per built-in template plus Custom, inflated by AddAquariumFragment
                 from BuiltInTemplates so this list cannot drift from the templates the
                 dashboard actually enforces. -->
            <LinearLayout
                android:id="@+id/templateChoiceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- TODO (DS-4.4): Advanced Settings goes back here, collapsed by default:
                 aquariumnotes, per-sensor threshold overrides -->

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Button -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateAquarium"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_auth_primary_button"
            android:letterSpacing="0"
            android:text="@string/action_create_aquarium"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</RelativeLayout>
