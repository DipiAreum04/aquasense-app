<?xml version="1.0" encoding="utf-8"?>
<!-- One built-in template. Populated by AquariumTemplateCardBinder from an AquariumTemplate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_settings_card"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivTemplateIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_template_icon"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="8dp"
            tools:src="@drawable/template_freshwater" />

        <TextView
            android:id="@+id/tvTemplateWaterType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:letterSpacing="0.06"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textAllCaps="true"
            android:textColor="@color/water_badge_text"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:background="@drawable/bg_water_badge_freshwater"
            tools:text="Freshwater" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTemplateName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/template_heading"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Tropical Freshwater" />

    <TextView
        android:id="@+id/tvTemplateDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="Warm, near-neutral water. The most common community tank." />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:letterSpacing="0.06"
        android:text="@string/template_common_species"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Wraps onto as many lines as the species need. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/containerSpecies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivThresholdsIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/equalizer_24px" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/template_range_thresholds"
            android:textColor="@color/template_heading"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- One band bar per ranged sensor. -->
    <LinearLayout
        android:id="@+id/containerParameters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

    <!-- Shown only when the template disables a sensor -->
    <TextView
        android:id="@+id/tvDisabledNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_template_note"
        android:lineSpacingExtra="2dp"
        android:padding="12dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
