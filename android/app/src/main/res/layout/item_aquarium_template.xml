<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_settings_card"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivTemplateIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_template_icon"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="8dp"
            tools:src="@drawable/template_freshwater" />

        <TextView
            android:id="@+id/tvTemplateWaterType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:letterSpacing="0.06"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textAllCaps="true"
            android:textColor="@color/water_badge_text"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:background="@drawable/bg_water_badge_freshwater"
            tools:text="Freshwater" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTemplateName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/template_heading"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Tropical Freshwater" />

    <TextView
        android:id="@+id/tvTemplateDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="Warm, near-neutral water. The most common community tank." />

    <include
        layout="@layout/item_template_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp" />

</LinearLayout>
