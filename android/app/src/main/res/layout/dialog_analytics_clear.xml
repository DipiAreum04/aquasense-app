<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_analytics_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_analytics_dialog_icon"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="16dp"
        android:src="@drawable/delete_forever_24px"
        app:tint="@color/status_red" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:text="@string/analytics_clear_title"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_analytics_dialog_summary"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout style="@style/Widget.AquaSense.AnalyticsDialogRow">

            <TextView
                style="@style/Widget.AquaSense.AnalyticsDialogRowLabel"
                android:text="@string/analytics_clear_field_aquarium" />

            <TextView
                android:id="@+id/analyticsClearAquarium"
                style="@style/Widget.AquaSense.AnalyticsDialogRowValue"
                tools:text="Living Room Reef" />

        </LinearLayout>

        <LinearLayout
            style="@style/Widget.AquaSense.AnalyticsDialogRow"
            android:layout_marginTop="8dp">

            <TextView
                style="@style/Widget.AquaSense.AnalyticsDialogRowLabel"
                android:text="@string/analytics_clear_field_sensor" />

            <TextView
                android:id="@+id/analyticsClearSensor"
                style="@style/Widget.AquaSense.AnalyticsDialogRowValue"
                tools:text="Temperature" />

        </LinearLayout>

        <LinearLayout
            style="@style/Widget.AquaSense.AnalyticsDialogRow"
            android:layout_marginTop="8dp">

            <TextView
                style="@style/Widget.AquaSense.AnalyticsDialogRowLabel"
                android:text="@string/analytics_clear_field_period" />

            <TextView
                android:id="@+id/analyticsClearPeriod"
                style="@style/Widget.AquaSense.AnalyticsDialogRowValue"
                tools:text="Last 24 hours" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="3sp"
        android:text="@string/analytics_clear_message"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/analyticsClearCancel"
            style="@style/Widget.AquaSense.AnalyticsDialogButton"
            android:background="@drawable/bg_analytics_dialog_cancel"
            android:text="@string/analytics_clear_cancel"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/analyticsClearConfirm"
            style="@style/Widget.AquaSense.AnalyticsDialogButton"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_analytics_dialog_confirm"
            android:text="@string/analytics_clear_confirm"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>
