<?xml version="1.0" encoding="utf-8"?>
<!-- Host for the SETTINGS-03 first-installation wizard. Each destination draws its own toolbar,
     as the dashboard's screens do, so no action bar is set here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_setup"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_setup"
        tools:layout="@layout/fragment_setup_welcome" />

</LinearLayout>
