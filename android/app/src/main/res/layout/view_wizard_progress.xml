<?xml version="1.0" encoding="utf-8"?>
<!--
    "STEP 1 OF 2" strip for the first-installation wizard, driven by WizardProgress.

    Included under the toolbar of every screen the wizard walks through, hidden by default: the
    same two screens are also reachable from the dashboard, where there is no wizard to report
    progress for.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wizardProgress"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="4dp"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:id="@+id/tvWizardStepLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="STEP 1 OF 2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <View
            android:id="@+id/wizardSegment1"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wizard_progress_done" />

        <View
            android:id="@+id/wizardSegment2"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wizard_progress_todo" />

        <View
            android:id="@+id/wizardSegment3"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wizard_progress_todo" />
    </LinearLayout>

</LinearLayout>
