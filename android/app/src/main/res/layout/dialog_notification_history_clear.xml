<?xml version="1.0" encoding="utf-8"?>
<!-- Device-local history clear confirmation, styled like the app's analytics clear dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_analytics_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_analytics_dialog_icon"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="16dp"
        android:src="@drawable/delete_forever_24px"
        app:tint="@color/status_red" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/notification_history_clear_all_title"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="3sp"
        android:text="@string/notification_history_clear_all_message"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notificationHistoryClearCancel"
            style="@style/Widget.AquaSense.AnalyticsDialogButton"
            android:background="@drawable/bg_analytics_dialog_cancel"
            android:text="@string/notification_history_clear_all_cancel"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/notificationHistoryClearConfirm"
            style="@style/Widget.AquaSense.AnalyticsDialogButton"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_analytics_dialog_confirm"
            android:text="@string/notification_history_clear_all_confirm"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>
