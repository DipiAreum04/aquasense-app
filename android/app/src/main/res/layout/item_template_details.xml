<?xml version="1.0" encoding="utf-8"?>
<!-- Template details block on Add Aquarium screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="@string/template_common_species"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Wraps onto as many lines as the species need. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/containerSpecies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivThresholdsIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/equalizer_24px" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/template_range_thresholds"
            android:textColor="@color/template_heading"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- One band bar per ranged sensor. -->
    <LinearLayout
        android:id="@+id/containerParameters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

    <!-- Shown only when the template disables a sensor -->
    <TextView
        android:id="@+id/tvDisabledNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_template_note"
        android:lineSpacingExtra="2dp"
        android:padding="12dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
