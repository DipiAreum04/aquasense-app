<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_mount_hub"
        style="@style/Widget.AquaSense.Toolbar"
        android:layout_alignParentTop="true" />

    <include
        android:id="@+id/wizardProgress"
        layout="@layout/view_wizard_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar_mount_hub" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/wizardProgress">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/mountIllustration"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/setup_mount_illustration_description"
                android:src="@drawable/illustration_hub_mount" />

            <TextView
                android:id="@+id/tvMountIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/setup_mount_intro"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/mountStepPlace"
                style="@style/Widget.AquaSense.MountStep">

                <TextView
                    style="@style/Widget.AquaSense.MountStepNumber"
                    android:text="@string/step_number_1" />

                <LinearLayout
                    style="@style/Widget.AquaSense.MountStepText">

                    <TextView
                        style="@style/Widget.AquaSense.MountStepTitle"
                        android:text="@string/setup_mount_step_place_title" />

                    <TextView
                        style="@style/Widget.AquaSense.MountStepBody"
                        android:text="@string/setup_mount_step_place_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mountStepProbes"
                style="@style/Widget.AquaSense.MountStep">

                <TextView
                    style="@style/Widget.AquaSense.MountStepNumber"
                    android:text="@string/step_number_2" />

                <LinearLayout
                    style="@style/Widget.AquaSense.MountStepText">

                    <TextView
                        style="@style/Widget.AquaSense.MountStepTitle"
                        android:text="@string/setup_mount_step_probes_title" />

                    <TextView
                        style="@style/Widget.AquaSense.MountStepBody"
                        android:text="@string/setup_mount_step_probes_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mountStepLevel"
                style="@style/Widget.AquaSense.MountStep">

                <TextView
                    style="@style/Widget.AquaSense.MountStepNumber"
                    android:text="@string/step_number_3" />

                <LinearLayout
                    style="@style/Widget.AquaSense.MountStepText">

                    <TextView
                        style="@style/Widget.AquaSense.MountStepTitle"
                        android:text="@string/setup_mount_step_level_title" />

                    <TextView
                        style="@style/Widget.AquaSense.MountStepBody"
                        android:text="@string/setup_mount_step_level_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mountStepPower"
                style="@style/Widget.AquaSense.MountStep">

                <TextView
                    style="@style/Widget.AquaSense.MountStepNumber"
                    android:text="@string/step_number_4" />

                <LinearLayout
                    style="@style/Widget.AquaSense.MountStepText">

                    <TextView
                        style="@style/Widget.AquaSense.MountStepTitle"
                        android:text="@string/setup_mount_step_power_title" />

                    <TextView
                        style="@style/Widget.AquaSense.MountStepBody"
                        android:text="@string/setup_mount_step_power_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.AquaSense.Button.Primary"
            android:id="@+id/btnMountHubNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_auth_primary_button"
            android:letterSpacing="0"
            android:text="@string/setup_mount_next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/btnSkipSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/add_aquarium_first_run_skip"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

</RelativeLayout>
