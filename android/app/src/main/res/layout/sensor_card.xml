<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
><!--
      The stroke colour is replaced per status at bind time; the one the preview draws comes from
      the theme.
    -->
    <!--
      Height follows the content rather than being fixed, so every vertical gap is a declared
      margin. Anchoring the pill to the card's bottom instead left that last gap as whatever a
      fixed height had spare, which drifted against the 12dp above and with the font scale.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
    >
        <!-- Sensor icon and its info affordance share the top rule, one to each edge. -->
        <ImageView
            android:id="@+id/sensorTitleIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@null"
        />
        <ImageView
            android:id="@+id/sensorTooltipIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/sensorTitleIcon"
            app:layout_constraintBottom_toBottomOf="@id/sensorTitleIcon"
            app:tint="@color/sensor_content_primary"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
        />

        <TextView
            android:id="@+id/sensorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="12dp"
            android:textColor="@color/sensor_name_text"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sensorTitleIcon"
        />

        <!-- Reading and unit ride the same baseline, centred as one block. -->
        <LinearLayout
            android:id="@+id/sensorReading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sensorName"
        >
            <TextView
                android:id="@+id/sensorValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:textStyle="bold"
            />
            <TextView
                android:id="@+id/sensorUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textSize="14sp"
            />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sensorStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sensor_status_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sensorReading"
        >
            <ImageView
                android:id="@+id/sensorStatusIcon"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
            />
            <TextView
                android:id="@+id/sensorStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
            />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
