<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvParameterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Temperature (°C)" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/segmentCriticalLow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_band_start"
            android:backgroundTint="@color/template_band_critical" />

        <View
            android:id="@+id/segmentWarningLow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/template_band_warning" />

        <View
            android:id="@+id/segmentSafe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/template_band_normal" />

        <View
            android:id="@+id/segmentWarningHigh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/template_band_warning" />

        <View
            android:id="@+id/segmentCriticalHigh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_band_end"
            android:backgroundTint="@color/template_band_critical" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBoundLow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:textColor="@color/status_red"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="&lt; 22" />

        <TextView
            android:id="@+id/tvBandSafe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/status_green"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="24 – 27" />

        <TextView
            android:id="@+id/tvBoundHigh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/status_red"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="&gt; 29" />

    </LinearLayout>

</LinearLayout>
