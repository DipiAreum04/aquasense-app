<?xml version="1.0" encoding="utf-8"?>
<!-- One selectable template row on the Add Aquarium screen. Populated by AddAquariumFragment from
     an AquariumTemplate, or left as the Custom option. Tapping the row selects it; the footer at the
     bottom opens what the template actually means, the same species chips and threshold bars as the
     Settings templates screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_settings_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivTemplateChoiceIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_template_icon"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="4dp"
            tools:src="@drawable/template_freshwater" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTemplateChoiceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gray_900"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Saltwater: Marine" />

            <TextView
                android:id="@+id/tvTemplateChoiceDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/gray_500"
                android:textSize="12sp"
                tools:text="Warm, alkaline saltwater with tight tolerances." />

            <LinearLayout
                android:id="@+id/templateChoiceMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTemplateChoiceWaterType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textAllCaps="true"
                    android:textColor="@color/water_badge_text"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:background="@drawable/bg_water_badge_saltwater"
                    tools:text="Saltwater" />
            </LinearLayout>
        </LinearLayout>

        <RadioButton
            android:id="@+id/rbTemplateChoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/templateChoiceDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginBottom="16dp"
            android:background="@color/divider" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/templateChoiceExpander"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="start|center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTemplateChoiceHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/template_choice_show_details"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
