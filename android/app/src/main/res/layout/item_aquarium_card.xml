<?xml version="1.0" encoding="utf-8"?>
<!-- One aquarium on the My Aquariums screen. Populated by AquariumSelectorFragment -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aquariumCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_settings_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="96dp"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="20dp">

    <ImageView
        android:id="@+id/ivAquariumIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_template_icon"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="6dp"
        tools:src="@drawable/template_freshwater" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAquariumName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gray_900"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="My Aquarium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAquariumStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textAllCaps="true"
                android:textColor="@color/water_badge_text"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:background="@drawable/bg_water_badge_freshwater"
                tools:text="Freshwater" />

            <TextView
                android:id="@+id/tvActiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_active_badge"
                android:letterSpacing="0.06"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/badge_active"
                android:textAllCaps="true"
                android:textColor="@color/sky_600"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/btnDeleteAquarium"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_delete"
        android:padding="8dp"
        android:src="@drawable/delete_aquarium" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/icon_gray" />

</LinearLayout>
