<?xml version="1.0" encoding="utf-8"?>
<!--
  SETTINGS-07 - the thresholds every alert, every dashboard status colour and every analytics
  in-range count is judged against, for one sensor of one aquarium at a time.

  Reading down: which aquarium, the tabs, then that sensor's range and its spike limit. The two
  notes explaining the sensors that have no tab are last, below the save, so that the screen leads
  with what can be configured and leaves what cannot to the end. TDS comes first of the two since
  it is the conditional one, appearing only for saltwater; water level closes the page, as it is
  absent for every aquarium.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
          Which aquarium's thresholds are being edited. This is the same selection the dashboard
          and analytics show, so changing it here changes it there: one active aquarium throughout.
        -->
        <LinearLayout
            android:id="@+id/waterParametersAquariumSelector"
            style="@style/Widget.AquaSense.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/rounded_ripple_10dp_radius"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/waterParametersAquariumIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_template_icon"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="5dp"
                tools:src="@drawable/aquarium_freshwater" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/analytics_active_aquarium"
                    android:textAllCaps="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/waterParametersAquariumName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Living Room Reef" />

            </LinearLayout>

            <!-- Turned the rest of the way over while the list is open; see AquariumDropdown. -->
            <ImageView
                android:id="@+id/waterParametersAquariumChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/analytics_aquarium_selector_description"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />

        </LinearLayout>

        <!-- Shown instead of the form when the user has no aquarium yet. -->
        <TextView
            android:id="@+id/tvWaterParametersEmpty"
            style="@style/Widget.AquaSense.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_card"
            android:padding="16dp"
            android:text="@string/water_parameters_no_aquarium"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/containerWaterParametersForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tabs are added in code, one per sensor this aquarium's water type can measure. -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabsWaterParameterSensor"
                style="@style/Widget.AquaSense.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_settings_card"
                android:clipToOutline="true"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/accent"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="3dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="@color/accent"
                app:tabTextAppearance="@style/TextAppearance.AquaSense.Tab"
                app:tabTextColor="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/threshold_section_safe_range"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <!-- OVERALL RANGE -->
            <LinearLayout
                style="@style/Widget.AquaSense.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvOverallRangeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/threshold_overall_range"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Segment widths are assigned as layout weights by ThresholdBandBar, from
                     whatever is currently typed into the four cards below. -->
                <LinearLayout
                    android:id="@+id/overallRangeBar"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/segmentCriticalLow"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_band_start"
                        android:backgroundTint="@color/template_band_critical" />

                    <View
                        android:id="@+id/segmentWarningLow"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/template_band_warning" />

                    <View
                        android:id="@+id/segmentSafe"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/template_band_normal" />

                    <View
                        android:id="@+id/segmentWarningHigh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/template_band_warning" />

                    <View
                        android:id="@+id/segmentCriticalHigh"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_band_end"
                        android:backgroundTint="@color/template_band_critical" />

                </LinearLayout>

                <!-- Three labels: the outer two mark where critical begins, the middle one is the
                     safe band. These are the only place critical is spelled out as a number, and
                     it is derived from the warning bounds rather than entered. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOverallRangeLow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:textColor="@color/status_red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="&lt; 22" />

                    <TextView
                        android:id="@+id/tvOverallRangeSafe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/status_blue"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="24 - 27" />

                    <TextView
                        android:id="@+id/tvOverallRangeHigh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/status_red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="&gt; 29" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/Widget.AquaSense.AnalyticsLegendKey">

                        <ImageView
                            style="@style/Widget.AquaSense.AnalyticsLegendDot"
                            android:importantForAccessibility="no"
                            android:src="@drawable/red_circle_24" />

                        <TextView
                            style="@style/Widget.AquaSense.AnalyticsLegendLabel"
                            android:text="@string/template_legend_critical" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.AquaSense.AnalyticsLegendKey"
                        android:layout_marginStart="16dp">

                        <ImageView
                            style="@style/Widget.AquaSense.AnalyticsLegendDot"
                            android:importantForAccessibility="no"
                            android:src="@drawable/orange_circle_24" />

                        <TextView
                            style="@style/Widget.AquaSense.AnalyticsLegendLabel"
                            android:text="@string/template_legend_warning" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.AquaSense.AnalyticsLegendKey"
                        android:layout_marginStart="16dp">

                        <ImageView
                            style="@style/Widget.AquaSense.AnalyticsLegendDot"
                            android:importantForAccessibility="no"
                            android:src="@drawable/blue_circle_24" />

                        <TextView
                            style="@style/Widget.AquaSense.AnalyticsLegendLabel"
                            android:text="@string/template_legend_safe" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- The four bound cards, inflated from item_threshold_level, low to high so they run
                 in the same direction as the bar above them. -->
            <LinearLayout
                android:id="@+id/containerThresholdLevels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- A spike is a distance rather than a place on the scale, so it is its own section
                 rather than a fifth bound. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/threshold_section_sudden_change"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/containerSpikeLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Says which other tab is holding the save back, since its errors are not on screen. -->
            <TextView
                android:id="@+id/tvWaterParametersBlocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Fix the errors on the pH Level tab before saving."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveThresholds"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_auth_primary_button"
                android:text="@string/threshold_save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!--
          The two sensors with no tab, explained where they cannot be mistaken for something to fill
          in. Both are the same card: an icon, what is missing, and why.

          DISSOLVED SOLIDS - only for the saltwater template, whose TDS probe cannot read that range.
          The body is set from the template's own note, so this card carries no wording of its own.
        -->
        <LinearLayout
            android:id="@+id/cardWaterParametersTdsNote"
            style="@style/Widget.AquaSense.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/total_dissolved_solids_24px"
                    app:tint="@color/settings_icon_cyan" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/threshold_tds_note_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvWaterParametersTdsNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="TDS sensor range is below saltwater levels." />

        </LinearLayout>

        <!--
          WATER LEVEL - last on the page, since unlike the TDS note above it applies to every
          aquarium rather than only the saltwater ones.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.AquaSense.Card"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/water_24px"
                    app:tint="@color/settings_icon_teal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/threshold_water_level_note_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/threshold_water_level_note"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
