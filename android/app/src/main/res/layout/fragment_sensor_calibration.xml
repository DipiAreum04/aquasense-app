<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="4dp"
            android:text="@string/calibration_intro"
            android:textAppearance="@style/TextAppearance.AquaSense.RowDesc"
            android:textColor="@color/text_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            style="@style/Widget.AquaSense.Card"
            android:orientation="vertical">

            <!-- Liquid Level -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/rowGuideLiquid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_info_water_level_title"
                        android:textAppearance="@style/TextAppearance.AquaSense.RowTitle.Accent" />

                    <TextView
                        android:id="@+id/tvLiquidDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/never_calibrated"
                        android:textAppearance="@style/TextAppearance.AquaSense.RowDesc" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvLiquidStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/never"
                    android:textStyle="bold"                    
                    android:textAppearance="@style/TextAppearance.AquaSense.RowValue.Muted" />

                <Button
                    android:id="@+id/btnCalibrateLiquid"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calibrate"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:background="@color/divider" />

            <!-- Temperature -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/rowGuideTemp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_info_temperature_title"
                        android:textAppearance="@style/TextAppearance.AquaSense.RowTitle.Accent" />

                    <TextView
                        android:id="@+id/tvTempDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/never_calibrated"
                        android:textAppearance="@style/TextAppearance.AquaSense.RowDesc" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTempStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/never"
                    android:textStyle="bold"                   
                    android:textAppearance="@style/TextAppearance.AquaSense.RowValue.Muted" />

                <Button
                    android:id="@+id/btnCalibrateTemp"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calibrate"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:background="@color/divider" />

            <!-- Dissolved Solids -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/rowGuideTds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_info_dissolved_solids_title"
                        android:textAppearance="@style/TextAppearance.AquaSense.RowTitle.Accent" />

                    <TextView
                        android:id="@+id/tvTdsDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/never_calibrated"
                        android:textAppearance="@style/TextAppearance.AquaSense.RowDesc" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTdsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/never"
                    android:textStyle="bold"                    
                    android:textAppearance="@style/TextAppearance.AquaSense.RowValue.Muted" />

                <Button
                    android:id="@+id/btnCalibrateTds"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calibrate"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:background="@color/divider" />

            <!-- pH Level -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/rowGuidePh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_info_ph_level_title"
                        android:textAppearance="@style/TextAppearance.AquaSense.RowTitle.Accent" />

                    <TextView
                        android:id="@+id/tvPhDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/never_calibrated"
                        android:textAppearance="@style/TextAppearance.AquaSense.RowDesc" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPhStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/never"
                    android:textStyle="bold"                    
                    android:textAppearance="@style/TextAppearance.AquaSense.RowValue.Muted" />

                <Button
                    android:id="@+id/btnCalibratePh"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calibrate"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
