<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared theme items live on the base style so the API 35+ variant in
         values-v35/themes.xml can inherit them. Redeclaring Theme.AquaSense in a
         qualified folder replaces the whole style rather than merging into it. -->
    <style name="Base.Theme.AquaSense" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Covers screens that do not set a background on their root view. @color/background
             is DayNight-aware, so values-night/colors.xml still supplies the dark variant. -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <!-- Matches the left edge of @drawable/bg_toolbar_gradient so the status bar
             reads as part of the toolbar rather than a separate band. Both are
             DayNight-aware, so no values-night theme is needed. -->
        <item name="android:statusBarColor">@color/toolbar_gradient_start</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar_icons</item>
    </style>

    <style name="Theme.AquaSense" parent="Base.Theme.AquaSense" />
</resources>
