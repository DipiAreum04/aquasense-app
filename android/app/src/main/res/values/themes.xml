<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.AquaSense" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">@color/color_on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/color_on_accent</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlHighlight">@color/analytics_action_ripple</item>

        <item name="buttonStyle">@style/Widget.AquaSense.Button.Primary</item>
        <item name="materialButtonStyle">@style/Widget.AquaSense.Button.Primary</item>
        <item name="borderlessButtonStyle">@style/Widget.AquaSense.Button.Text</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AquaSense.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AquaSense.MaterialAlertDialog</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.AquaSense.MaterialTimePicker</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.AquaSense.BottomSheetDialog</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/toolbar_gradient_start</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar_icons</item>
    </style>

    <style name="Theme.AquaSense" parent="Base.Theme.AquaSense" />

    <style name="Theme.AquaSense.Splash" parent="Theme.AquaSense">
        <item name="android:windowBackground">@drawable/ic_launcher_ocean_gradient</item>
        <item name="android:statusBarColor">@color/launcher_ocean_start</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
