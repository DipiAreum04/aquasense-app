<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.AquaSense.Card" parent="">
        <item name="android:elevation">6dp</item>
        <item name="android:outlineAmbientShadowColor">@color/card_shadow</item>
        <item name="android:outlineSpotShadowColor">@color/card_shadow</item>
    </style>

    <style name="Widget.AquaSense.Card.Auth">
        <item name="android:elevation">14dp</item>
    </style>

    <style name="Widget.AquaSense.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="android:background">@drawable/bg_toolbar_gradient</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.DayNight.ActionBar</item>
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.DayNight</item>
        <item name="titleTextColor">@color/sensor_info_title_color</item>
        <item name="navigationIconTint">@color/sensor_info_title_color</item>
    </style>


    <style name="TextAppearance.AquaSense.SectionHeader" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.AquaSense.RowTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AquaSense.RowTitle.Danger">
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="TextAppearance.AquaSense.RowTitle.Accent">
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="TextAppearance.AquaSense.RowDesc" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.AquaSense.RowValue" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="TextAppearance.AquaSense.RowValue.Muted">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.AquaSense.FieldInput" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AquaSense.ProfileName" parent="TextAppearance.AppCompat">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AquaSense.ProfileEmail" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.AquaSense.Tab" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsStatLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsStatValueRow" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:baselineAligned">true</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsStatValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsStatUnit" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsLegendKey" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsLegendDot" parent="">
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsLegendLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsLegendValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AquaSense.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:background">@drawable/bg_auth_primary_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AquaSense.Button.Secondary"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:background">@drawable/bg_pairing_secondary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AquaSense.Button.Text"
        parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.AquaSense.Button.Text.Danger">
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Widget.AquaSense.Button.Google"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:background">@drawable/bg_auth_google_button</item>
        <item name="backgroundTint">@color/auth_google_button_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.AquaSense.Dialog"
        parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="MaterialAlertDialog.AquaSense"
        parent="MaterialAlertDialog.MaterialComponents">
        <item name="backgroundTint">@color/card_background</item>
        <item name="shapeAppearance">@style/ShapeAppearance.AquaSense.Dialog</item>
    </style>

    <style name="MaterialAlertDialog.AquaSense.Title.Text"
        parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MaterialAlertDialog.AquaSense.Body.Text"
        parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.AquaSense.Button.Dialog"
        parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.AquaSense.Button.Dialog.Danger">
        <item name="android:textColor">@color/dialog_button_danger_text</item>
    </style>

    <style name="ThemeOverlay.AquaSense.MaterialAlertDialog"
        parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.AquaSense</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.AquaSense.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.AquaSense.Body.Text</item>
        <item name="buttonBarButtonStyle">@style/Widget.AquaSense.Button.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AquaSense.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AquaSense.Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.AquaSense.Button.Dialog</item>
    </style>

    <style name="ThemeOverlay.AquaSense.MaterialAlertDialog.Danger"
        parent="ThemeOverlay.AquaSense.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AquaSense.Button.Dialog.Danger</item>
    </style>

    <style name="ThemeOverlay.AquaSense.MaterialTimePicker"
        parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AquaSense.Dialog</item>
        <item name="borderlessButtonStyle">@style/Widget.AquaSense.Button.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AquaSense.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AquaSense.Button.Dialog</item>
    </style>

    <style name="ShapeAppearance.AquaSense.BottomSheet"
        parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyBottomRight">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.AquaSense.BottomSheet.Modal"
        parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/card_background</item>
        <item name="shapeAppearance">@style/ShapeAppearance.AquaSense.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.AquaSense.BottomSheetDialog"
        parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.AquaSense.BottomSheet.Modal</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsChartAction" parent="">
        <item name="android:layout_width">@dimen/analytics_action_button_size</item>
        <item name="android:layout_height">@dimen/analytics_action_button_size</item>
        <item name="android:background">@drawable/bg_analytics_action_button</item>
        <item name="android:padding">@dimen/analytics_action_icon_padding</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/accent</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsInfoButton" parent="">
        <item name="android:layout_width">@dimen/analytics_info_button_size</item>
        <item name="android:layout_height">@dimen/analytics_info_button_size</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/analytics_info_icon_padding</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/info_24px</item>
        <item name="android:tint">@color/text_secondary</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsDialogRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:baselineAligned">true</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsDialogRowLabel" parent="">
        <item name="android:layout_width">78dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsDialogRowValue" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AquaSense.AnalyticsDialogButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AquaSense.MountStep" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/bg_settings_card</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.AquaSense.MountStepNumber" parent="">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:background">@drawable/bg_step_number</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AquaSense.MountStepText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.AquaSense.MountStepTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AquaSense.MountStepBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.AquaSense.SettingsDialogOption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_settings_dialog_option</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>
