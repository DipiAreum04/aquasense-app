    <!--
      Dashboard header. Every colour below is derived from the status colour the sensor cards use
      for the same status, so the header and the grid speak with one voice:

        normal @color/status_blue, warning @color/status_orange,
        critical @color/status_red, disconnected @color/status_gray

      The gradient and the wave keep the lightness and the chroma they were tuned to and take only
      the hue of that status colour, so each status holds the ramp the header was designed at
      while still reading as itself. The accent is the status colour at a fixed lightness, dark
      enough to carry the heading over the band beneath it.

      All of it is measured in CIELAB, not HSL: HSL lightness is (max+min)/2, which says green and
      blue of the same "lightness" look equally light when green is far lighter. Re-hueing the
      blue header in HSL flattened the green ramp by a fifth. In LCh the rule is exactly
      gradient/wave = (own L*, own C*, status hue) and accent = (L* 34, status C*, status hue),
      and scratchpad/rehue.py re-derives every value below from those two lines.
    -->

    <!-- Drawn at angle=90, i.e. bottom-to-top, so _start is the deeper band that meets the wave
         and _end the lighter band behind the aquarium chip. -->
    <color name="aquarium_sensors_status_normal_gradient_start">#FF87C9D6</color>
    <color name="aquarium_sensors_status_normal_gradient_end">#FFBAE5EE</color>
    <color name="aquarium_sensors_status_warning_gradient_start">#FFF6B43E</color>
    <color name="aquarium_sensors_status_warning_gradient_end">#FFFFE4C0</color>
    <color name="aquarium_sensors_status_critical_gradient_start">#FFEF8F89</color>
    <color name="aquarium_sensors_status_critical_gradient_end">#FFFBDCD8</color>
    <color name="aquarium_sensors_status_disconnected_gradient_start">#FFD5D5DB</color>
    <color name="aquarium_sensors_status_disconnected_gradient_end">#FFF0F1F3</color>

