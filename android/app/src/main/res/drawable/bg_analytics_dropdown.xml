<?xml version="1.0" encoding="utf-8"?>
<!--
  The panel the aquarium dropdown drops as. It shares the selector card's fill and radius, so what
  opens looks like the card it came out of.

  The hairline is what a card gets instead of a shadow here: a PopupWindow takes its shape from this
  drawable and casts no shadow of its own unless the drawable draws one, and a white panel opening
  over the near-white page needs an edge to be read as a separate surface.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card_background" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />
</shape>
