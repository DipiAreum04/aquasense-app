<?xml version="1.0" encoding="utf-8"?>
<!--
  Background of one analytics period button. Only the selected one is drawn: it is filled with the
  raised surface and lifts out of the groove the row is drawn on, while the rest let that groove
  show through. See @drawable/bg_analytics_period_track for the pair of radii.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/analytics_segment_selected" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</selector>
