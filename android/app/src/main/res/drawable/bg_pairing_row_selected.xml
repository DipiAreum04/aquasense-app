<?xml version="1.0" encoding="utf-8"?>
<!-- A hub the user has picked. Tinted fill plus a full-weight border so it reads as selected -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pairing_row_selected_fill" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1.5dp"
        android:color="@color/pairing_row_selected_stroke" />
</shape>
