<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/launcher_ocean_start"
                android:endColor="@color/launcher_ocean_end" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="72%"
                android:centerX="0.18"
                android:centerY="0.16"
                android:startColor="@color/launcher_rim_light_start"
                android:centerColor="@color/launcher_rim_light_center"
                android:endColor="@color/transparent" />
        </shape>
    </item>

</layer-list>
