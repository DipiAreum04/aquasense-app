<?xml version="1.0" encoding="utf-8"?>
<!--
  The block naming what is about to be deleted - which tank, which sensor, which window. Drawn on
  the period row's groove so the three lines read as one quoted thing rather than as more prose,
  and so what the dialog is quoting is visibly the selection the page was left on.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/analytics_segment_track" />
    <corners android:radius="14dp" />
</shape>
