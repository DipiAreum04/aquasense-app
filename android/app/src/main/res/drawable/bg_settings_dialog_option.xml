<?xml version="1.0" encoding="utf-8"?>
<!--
  One choice in a settings dialog. The fill is transparent so the panel shows through and the row
  is only visible when it is touched; the rounded corner keeps that ripple inside the panel's own
  24dp edge rather than running square into it.

  The highlight comes from the theme rather than a colour resource, which is what keeps the press
  legible on both the light and the dark panel.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</ripple>
