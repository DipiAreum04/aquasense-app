<?xml version="1.0" encoding="utf-8"?>
<!-- The "Optional" pill on the Add Aquarium form's Advanced Settings heading. Carries a hairline
     edge as well as a fill, so it still reads as a pill against a card of a similar tone. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/optional_badge_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/optional_badge_stroke" />
    <corners android:radius="14dp" />
</shape>
