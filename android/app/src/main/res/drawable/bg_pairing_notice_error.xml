<?xml version="1.0" encoding="utf-8"?>
<!-- Carries the PairingFailure message and, when retryable, the retry button -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pairing_error_fill" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="@color/pairing_error_stroke" />
</shape>
